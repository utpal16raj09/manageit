# === Database (Neon Postgres) ===
# Copy the full connection string from Neon dashboard > Connect > Connection string
# Click "Show password" on the Neon dashboard to reveal the real password before copying
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-long-paper-azxgsuet.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# === Auth ===
# Generate a long random string for signing JWTs — do NOT reuse this example value
# You can generate one by running: openssl rand -base64 32
JWT_SECRET="REPLACE_WITH_RANDOM_GENERATED_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_GENERATED_SECRET"

# === Razorpay (add when you get to the payments milestone) ===
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# === WhatsApp BSP (add when you get to the communication milestone) ===
WHATSAPP_API_KEY=""

# === App ===
NODE_ENV="development"
PORT=3000
